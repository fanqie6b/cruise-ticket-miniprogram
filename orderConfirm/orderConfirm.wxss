/* pages/orderConfirm/orderConfirm.wxss */
.container {
  padding: 15px;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 50px;
}

.loading image {
  width: 50px;
  height: 50px;
  margin-bottom: 10px;
}

.route-info {
  background-color: #fff;
  border-radius: 8px;
  padding: 15px;
  margin-bottom: 15px;
}

.route-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 8px;
}

.route-desc {
  font-size: 14px;
  color: #666;
  margin-bottom: 8px;
}

.route-price {
  font-size: 16px;
  color: #f60;
}

.price-value {
  font-size: 20px;
  font-weight: bold;
}

.order-detail {
  background-color: #fff;
  border-radius: 8px;
  padding: 15px;
  margin-bottom: 15px;
}

.detail-item {
  display: flex;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid #eee;
}

.detail-item:last-child {
  border-bottom: none;
}

.item-label {
  width: 80px;
  color: #666;
}

.item-value {
  flex: 1;
  padding-left: 10px;
}

.total {
  font-weight: bold;
}

.total-price {
  color: #f60;
  font-size: 18px;
}

.picker {
  padding-left: 10px;
  color: #333;
}

.submit-btn {
  background-color: #f60;
  color: #fff;
  height: 45px;
  line-height: 45px;
  border-radius: 22.5px;
  font-size: 18px;
  margin: 20px 0;
}
.submit-btn {
  background-color: #f60;
  color: #fff;
  height: 45px;
  line-height: 45px;
  border-radius: 22.5px;
  font-size: 18px;
  margin: 20px 0;
  width: 100%;
}