.cruise-activity-page {
  padding: 20rpx;
  background-color: #f5f5f5;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  margin: 20rpx 0;
  color: #333;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.activity-item {
  background-color: white;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.activity-img {
  width: 100%;
  height: 280rpx;
  border-radius: 10rpx;
  margin-bottom: 15rpx;
  object-fit: cover;
}

.activity-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.activity-description {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}