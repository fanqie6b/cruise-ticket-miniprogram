.container {
  padding: 16rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.order-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s;
}

.order-item:active {
  transform: scale(0.99);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 16rpx;
}

.order-header text:first-child {
  color: #666;
  font-size: 26rpx;
}

.status {
  font-size: 28rpx;
  font-weight: 500;
}

.status[data-status="0"] {
  color: #ff7d00; 
}

.status[data-status="1"] {
  color: #00b42a; 
}

.status[data-status="2"] {
  color: #1890ff;
}

.order-body {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.order-body text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.order-body text:first-child {
  color: #1890ff;
  font-weight: 500;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
