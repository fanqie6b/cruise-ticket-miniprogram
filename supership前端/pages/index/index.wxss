.index-page {
  background-color: #f3efe7;
}
.banner-item {
  position: relative;
}

.banner-text {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.8), rgba(0,0,0,0));
  padding: 20rpx 30rpx 40rpx;
  box-sizing: border-box;
}

.banner-title {
  color: white;
  font-size: 36rpx;
  font-weight: bold;
  display: block;
}

.banner-subtitle {
  color: rgba(255,255,255,0.8);
  font-size: 28rpx;
  display: block;
  margin-top: 10rpx;
}
.banner-swiper {
  width: 100%;
}
.banner-img {
  width: 100%;
  height: auto;
}

.search-box {
  display: flex;
  padding: 15rpx 20rpx;
  background-color: #F5F5F5;
}
.search-input {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 20rpx;
  border: 1px solid #ddd;
  border-radius: 30rpx 0 0 30rpx;
  font-size: 28rpx;
}
.search-btn {
  width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background-color: #008dda;
  color: #fff;
  border: none;
  border-radius: 0 30rpx 30rpx 0;
  font-size: 28rpx;
}

.quick-entry {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  padding: 20rpx;
  background-color: #EAF8FF;
}
.entry-item {
  width: 45%;
  text-align: center;
  margin-bottom: 20rpx;
}
.entry-icon {
  font-size: 40rpx;
  display: block;
  margin-bottom: 10rpx;
}
.entry-text {
  font-size: 26rpx;
}
.book-btn {
  width: 100%;
  height: 70rpx;
  line-height: 70rpx;
  background-color: #008dda;
  color: #fff;
  border: none;
  border-radius: 35rpx;
  font-size: 32rpx;
}

.hot-activity {
  padding: 20rpx; 
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.activity-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.activity-item {
  width: 48%; 
  background-color: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1); 
  display: flex;
  flex-direction: column;
}
.activity-img {
  width: 100%;
  height: 200rpx; 
  border-radius: 10rpx;
  margin-bottom: 10rpx;
  object-fit: cover; 
}
.activity-desc {
  font-size: 28rpx;
  margin-bottom: 10rpx;
  line-height: 40rpx; 
}
.activity-tag {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}
.activity-btn {
  width: 100%;
  height: 60rpx;
  line-height: 60rpx;
  background-color: #008dda; 
  color: #fff; 
  border: none;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.cruise-experience {
  padding: 20rpx;
  margin-bottom: 30rpx;
}
.cruise-scroll {
  width: 100%;
  padding: 10rpx 0;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.cruise-scroll::-webkit-scrollbar {
  display: none;
}
.cruise-item {
  width: 300rpx;
  margin-right: 20rpx;
  padding: 15rpx;
  box-sizing: border-box;
  vertical-align: top;
}
.cruise-img {
  width: 100%;
  height: 180rpx;
  border-radius: 10rpx;
  object-fit: cover;
  margin-bottom: 15rpx;
}
.cruise-name {
  font-size: 28rpx;
  text-align: center;
  white-space: normal;
  line-height: 40rpx;
  height: auto;
  padding: 5rpx 0;
  overflow: visible;
  display: block;
}


.hot-destinations {
  padding: 20rpx;
  margin-bottom: 40rpx;
}
.dest-scroll {
  width: 100%;
  padding: 10rpx 0;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.dest-scroll::-webkit-scrollbar {
  display: none;
}
.dest-item {
  width: 250rpx;
  margin-right: 20rpx;
  padding: 15rpx;
  box-sizing: border-box;
  vertical-align: top;
}
.dest-img {
  width: 100%;
  height: 160rpx;
  border-radius: 10rpx;
  object-fit: cover;
  margin-bottom: 15rpx;
}
.dest-name {
  font-size: 28rpx;
  text-align: center;
  white-space: normal;
  line-height: 40rpx;
  height: auto;
  padding: 5rpx 0;
  overflow: visible;
  display: block;
}

.index-page {
  background-color: #fff;
}
.banner-swiper {
  width: 100%;
}
.banner-img {
  width: 100%;
  height: auto;
}
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-container {
  width: 80%;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 20rpx;
}

.list-container {
  max-height: 400rpx;
  overflow-y: auto;
}

.list-item {
  padding: 25rpx 10rpx;
  font-size: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  text-align: center;
}
.list-item:active {
  background-color: #f5f5f5;
}

.picker-view {
  margin: 20rpx 0;
}
.picker-item {
  text-align: center;
  font-size: 30rpx;
}

.modal-btns {
  display: flex;
  margin-top: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  margin: 0 10rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
}
.modal-btn.cancel {
  background-color: #f5f5f5;
  color: #666;
}
.modal-btn.confirm {
  background-color: #008dda;
  color: #fff;
}

.selected-value {
  font-size: 24rpx;
  color: #008dda;
  margin-top: 5rpx;
  display: block;
}
.container {
  height: 100%;
  background-color: #f8f8f8;
}

.navbar {
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background-color: #1E90FF;
  color: white;
  font-size: 36rpx;
  font-weight: bold;
}

.swiper-container {
  margin: 30rpx 20rpx; 
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

swiper {
  height: 400rpx;
}

swiper image {
  width: 100%;
  height: 100%;
}

.swiper-text {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.5);
  color: white;
  font-size: 32rpx;
  font-weight: bold;
}

.content {
  padding: 20rpx;
}