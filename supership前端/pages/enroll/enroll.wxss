.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.logo {
  margin: 40rpx 0;
}
.logo image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 40rpx;
}

.form {
  width: 100%;
}

.input-row {
  display: flex;
  align-items: center;
  background-color: #fff;
  border: 1rpx solid #eee;
  border-radius: 10rpx;
  padding: 0 20rpx;
  margin-bottom: 30rpx;
}

.icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.input-row input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  color: #333;
}

.btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 10rpx;
  font-size: 32rpx;
  color: #fff;
}
.register-btn {
  background-color: #008dda;
}

.footer {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #999;
}
.link {
  color: #008dda;
  margin: 0 10rpx;
  text-decoration: underline;
}
.guest-link {
  color: #008dda;
  margin-top: 10rpx;
  display: block;
  text-decoration: underline;
}