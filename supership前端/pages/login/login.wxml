<!--pages/login/login.wxml-->
<!-- 登录页面主容器 -->
<view>
  <!-- 登录表单：绑定submit事件触发登录逻辑 -->
  <form bindsubmit="login">
    <!-- 用户名输入框 -->
    <view class="first">
      <input 
        id="username" 
        placeholder="请输入用户名" 
        placeholder-style="plas" 
        class="inputs"  
        type="text" 
        name="username"  
      ></input>
    </view>
    
    <!-- 密码输入框 -->
    <view class="second">
      <input 
        id="password" 
        placeholder="请输入密码" 
        placeholder-style="plas" 
        class="inputs"
        type="password"  
        name="password"  
      ></input>
    </view>
    
    <!-- 登录按钮 -->
    <view>
      <button class="loginBtn" form-type="submit">登录</button>
    </view>
    
    <!-- 注册入口：点击跳转到注册页面 -->
    <view class="cha" bindtap="enroll">
      <text class="no">没有账号，点此注册</text>
    </view>
  </form>
</view>