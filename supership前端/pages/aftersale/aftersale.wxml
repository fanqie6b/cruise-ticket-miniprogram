<view class="container">
  <view wx:if="{{isLoading}}" class="loading">加载中...</view>
  
  <view wx:if="{{errorMsg}}" class="error">{{errorMsg}}</view>
  
  <view wx:else class="order-list">
    <view class="order-item" wx:for="{{orderList}}" wx:key="id" bindtap="goToOrderDetail" data-order-id="{{item.id}}">
      <text class="order-id">订单编号: {{item.id}}</text>
      <text class="route-name">航线: {{item.route_name || '未知航线'}}</text>
      <text class="depart-date">日期: {{item.depart_date || '未知日期'}}</text>
      <text class="status">状态: {{item.refund_status || '处理中'}}</text>
      <button class="track-btn" bindtap="trackProgress" data-order-id="{{item.id}}">跟踪进度</button>
    </view>
    
    <view wx:if="{{orderList.length === 0}}" class="empty">暂无售后订单</view>
  </view>
</view>