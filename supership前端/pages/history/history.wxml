<!-- pages/history/history.wxml -->
<view class="history-container">
  <!-- 页面标题 -->
  <view class="page-title">历史订单</view>
  
  <!-- 展示已完成/已取消的订单 -->
  <view class="order-list">
    <!-- 订单项示例 -->
    <view class="order-item">
      <!-- 订单头部，包含订单编号和状态 -->
      <view class="order-header">
        <text class="order-number">订单编号：SP20250720001</text>
        <text class="order-status">已完成</text>
      </view>
      
      <!-- 订单详情信息：船班、日期、金额 -->
      <view class="order-info">
        <text class="info-item">船班名称：澜光溢彩号</text>
        <text class="info-item">出行日期：2025-07-10</text>
        <text class="info-item">金额：¥4599.00</text>
      </view>
      
      <!-- 订单操作按钮：查看详情 -->
      <view class="order-actions">
        <button class="action-btn" bindtap="viewDetail" data-order-id="{{item.id}}">查看详情</button>
      </view>
    </view>
    
    <!-- 可添加更多订单项 -->
  </view>
  
  <!-- 空状态提示 -->
  <view class="empty-state" wx:if="{{orderList.length === 0}}">
    <image src="/pages/images/empty_order.png" mode="widthFix"></image>
    <text>暂无历史订单</text>
  </view>
</view>