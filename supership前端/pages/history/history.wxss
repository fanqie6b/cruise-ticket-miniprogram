/* pages/history/history.wxss */
.history-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.page-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin: 30rpx 0;
  padding-left: 10rpx;
  border-left: 4rpx solid #1296db;
}

.order-list {
  margin-bottom: 20rpx;
}

.order-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.order-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.order-number {
  font-size: 28rpx;
  color: #666;
}

.order-status {
  font-size: 26rpx;
  color: #00B26A; 
  background-color: rgba(0, 178, 106, 0.1);
  padding: 5rpx 15rpx;
  border-radius: 20rpx;
}

.order-info {
  border-top: 1rpx solid #f5f5f5;
  padding-top: 15rpx;
  margin-bottom: 15rpx;
}

.info-item {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
}

.action-btn {
  background-color: #1296db;
  color: #fff;
  padding: 8rpx 25rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 150rpx;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-state text {
  font-size: 28rpx;
  color: #999;
}