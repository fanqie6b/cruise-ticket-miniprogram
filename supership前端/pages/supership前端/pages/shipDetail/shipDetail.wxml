<view class="container">
  <view class="navbar">
    <view class="back-btn" bindtap="onBack">
    </view>
    <text class="title">{{shipInfo.name}}</text>
  </view>

  <view class="ship-banner">
    <image src="{{shipInfo.image}}" mode="aspectFill"></image>
  </view>

  <view class="ship-info">
    <view class="ship-title">{{shipInfo.name}}</view>
    <view class="ship-desc">{{shipInfo.description}}</view>
    
    <view class="ship-features">
      <text class="feature-title">船上设施：</text>
      <view class="feature-list">
        <text wx:for="{{shipInfo.features}}" wx:key="index" class="feature-item">
          {{item}}
        </text>
      </view>
    </view>
    
    <view class="ship-specs">
      <text class="spec-item">吨位：{{shipInfo.tonnage}}</text>
      <text class="spec-item">载客量：{{shipInfo.capacity}}</text>
      <text class="spec-item">甲板层数：{{shipInfo.decks}}</text>
    </view>
  </view>

  <button class="book-btn" bindtap="onBook">立即预订</button>
</view>