/* 全局容器 */
.info-container {
  padding: 30rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

/* 顶部导航栏（关键：修改背景色为#008dda） */
.nav-bar {
  display: flex;
  align-items: center;
  height: 90rpx;
  padding: 0 20rpx;
  background-color: #008dda; /* 导航栏颜色修改 */
  border-radius: 12rpx 12rpx 0 0;
  margin-bottom: 30rpx;
}
.back-btn {
  font-size: 36rpx;
  color: #fff; /* 白色返回箭头 */
  margin-right: 20rpx;
}
.title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #fff; /* 白色标题 */
}

/* 进度条（修复文字显示+统一样式） */
.progress-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.step {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #e5e5e5;
  color: #999;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
  margin: 0 30rpx; /* 增加步骤间距 */
}
/* 修复步骤文字显示 */
.step::after {
  content: attr(data-step);
  position: absolute;
  bottom: -40rpx; /* 调整文字位置 */
  left: 50%;
  transform: translateX(-50%);
  font-size: 24rpx;
  color: #666;
  white-space: nowrap;
}
.step.active {
  background-color: #008dda; /* 激活态颜色 */
  color: #fff;
}
.line {
  flex: 1;
  height: 4rpx;
  background-color: #e5e5e5;
  z-index: 1;
}
.line.active {
  background-color: #008dda;
}

/* 卡片样式 */
.card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}
.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #008dda;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 15rpx;
}
.info-item {
  display: flex;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}
.label {
  width: 180rpx;
  color: #666;
}
.value {
  flex: 1;
  color: #333;
}

/* 航线信息 */
.route-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.port {
  text-align: center;
  width: 45%;
}
.port-name {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}
.time {
  font-size: 26rpx;
  color: #999;
}
.arrow {
  font-size: 40rpx;
  color: #008dda;
}
.route-days {
  text-align: center;
  font-size: 28rpx;
  color: #008dda;
  margin-top: 10rpx;
}

/* 按钮 */
.next-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background-color: #008dda;
  color: #fff;
  font-size: 32rpx;
  border-radius: 45rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 141, 218, 0.2);
}