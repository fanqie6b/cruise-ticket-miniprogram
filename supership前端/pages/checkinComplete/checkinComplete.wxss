.complete-container {
  padding: 20px;
}

.nav-bar {
  display: flex;
  align-items: center;
  margin-bottom: 20px;
}

.back-btn {
  font-size: 24px;
  margin-right: 10px;
  cursor: pointer;
}

.title {
  font-size: 20px;
  font-weight: bold;
}

.status {
  text-align: center;
  margin-bottom: 20px;
}

.success-text {
  font-size: 24px;
  color: green;
  font-weight: bold;
}

.order-info {
  border: 1px solid #ccc;
  padding: 10px;
  border-radius: 5px;
  margin-bottom: 20px;
}

.info-item {
  display: flex;
  margin-bottom: 10px;
}

.label {
  width: 100px;
  font-weight: bold;
}

.value {
  flex: 1;
}

.thanks {
  text-align: center;
  margin-bottom: 20px;
}

.home-btn {
  width: 100%;
}