<view class="complete-container">

  <view class="nav-bar">
    <view class="back-btn" bindtap="goBack">←</view>
    <view class="title">完成值船</view>
  </view>

  <view class="status">
    <text class="success-text">值船已完成</text>
  </view>

  <view class="order-info">
    <view class="info-item">
      <text class="label">订单号：</text>
      <text class="value">{{passengerInfo.orderNo}}</text>
    </view>
    <view class="info-item">
      <text class="label">邮轮名称：</text>
      <text class="value">{{passengerInfo.cruiseName}}</text>
    </view>
    <view class="info-item">
      <text class="label">出航日期：</text>
      <text class="value">{{passengerInfo.sailingDate}}</text>
    </view>
  </view>

  <view class="thanks">
    <text>感谢您的选择，祝您旅途愉快！</text>
  </view>

  <button class="home-btn" bindtap="goToHome">返回首页</button>
</view>