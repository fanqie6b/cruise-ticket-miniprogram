<view class="container">
  <!-- 航线信息 -->
  <view class="route-info">
    <text class="route-title">航线：{{routeInfo && routeInfo.routeName ? routeInfo.routeName : '上海-福冈-上海 澜光溢彩号'}}</text>
    <text class="route-desc">
      出发日期：{{routeInfo && routeInfo.departDate ? routeInfo.departDate : '2025-08-01'}} | 
      {{routeInfo && routeInfo.duration ? routeInfo.duration : '5天4晚'}}
    </text>
    <text class="route-price">¥{{routeInfo && routeInfo.price ? routeInfo.price : '4189.10'}}/人起</text>
  </view>

  <!-- 表单 -->
  <view class="form-item">
    <label>联系人姓名：</label>
    <input 
      value="{{contactName}}" 
      bindinput="handleInput" 
      data-field="contactName"
      placeholder="请输入姓名"
    />
  </view>
  
  <view class="form-item">
    <label>联系电话：</label>
    <input 
      type="number" 
      value="{{contactPhone}}" 
      bindinput="handleInput" 
      data-field="contactPhone"
      placeholder="请输入手机号"
    />
  </view>
  
  <view class="form-item">
    <label>乘客数量：</label>
    <input 
      type="number" 
      value="{{passengerCount}}" 
      bindinput="handleInput" 
      data-field="passengerCount"
      min="1"
      placeholder="请输入乘客数量"
    />
  </view>

  <button bindtap="submitOrder" class="submit-btn">提交订单</button>
</view>