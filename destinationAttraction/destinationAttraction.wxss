.attraction-img {
  width: 100%;
  height: auto;
  margin-bottom: 10px;
}
.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  padding: 20rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
}

.attractions-list {
  padding: 20rpx;
}

.attraction-item {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.attraction-img {
  width: 100%;
  height: 400rpx;
  object-fit: cover;
  border-radius: 10rpx;
  margin-bottom: 15rpx;
}

.attraction-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.attraction-description, .guide {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 10rpx;
}

.loading, .empty {
  padding: 50rpx;
  text-align: center;
  font-size: 30rpx;
  color: #999;
}