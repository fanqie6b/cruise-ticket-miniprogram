/* pages/shipDetail/shipDetail.wxss */
.container {
  height: 100%;
  background-color: white;
}

.navbar {
  display: flex;
  align-items: center;
  height: 100rpx;
  background-color: #008dda;
  padding: 0 20rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
}

.back-btn image {
  width: 100%;
  height: 100%;
}

.title {
  flex: 1;
  text-align: center;
  color: white;
  font-size: 36rpx;
  font-weight: bold;
}

.ship-banner {
  height: 450rpx;
}

.ship-banner image {
  width: 100%;
  height: 100%;
}

.ship-info {
  padding: 30rpx 20rpx;
}

.ship-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.ship-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 30rpx;
}

.ship-features {
  margin-bottom: 30rpx;
}

.feature-title {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 15rpx;
}

.feature-list {
  display: flex;
  flex-wrap: wrap;
}

.feature-item {
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 10rpx 20rpx;
  margin: 0 15rpx 15rpx 0;
  font-size: 26rpx;
}

.ship-specs {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 30rpx;
}

.spec-item {
  width: 50%;
  font-size: 28rpx;
  margin-bottom: 15rpx;
}

.book-btn {
  height: 90rpx;
  line-height: 90rpx;
  background-color: #008dda;
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 45rpx;
  margin: 30rpx 20rpx;
}