.aftersale-container {
  padding: 16px;
  background-color: #fff;
  min-height: 100vh;
  box-sizing: border-box;
}

.page-title {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  margin-bottom: 20px;
}

.order-card {
  background: #f8f8f8;
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 20px;
}

.order-item {
  display: flex;
  justify-content: space-between;
  font-size: 14px;
  color: #666;
  margin-bottom: 12px;
}

.label {
  color: #999;
  flex-shrink: 0;
}

.reason-section {
  margin-bottom: 20px;
}

.section-title {
  font-size: 16px;
  font-weight: bold;
  color: #333;
  margin-bottom: 12px;
}

.reason-item {
  display: flex;
  align-items: center;
  font-size: 14px;
  color: #666;
  margin-bottom: 8px;
}

.fee-section {
  margin-bottom: 20px;
}

.fee-text {
  font-size: 14px;
  color: #666;
  line-height: 1.6;
}

.highlight {
  color: #ff6700;
  font-weight: bold;
}

.btn-group {
  display: flex;
  gap: 12px;
  justify-content: center;
}

.btn {
  flex: 1;
  height: 44px;
  line-height: 44px;
  border-radius: 22px;
  font-size: 14px;
}

.submit-btn {
  background-color: #008dda;
  color: #fff;
}

.track-btn {
  background-color: #fff;
  color: #008dda;
  border: 1px solid #008dda;
}