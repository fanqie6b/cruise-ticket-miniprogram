.clear-filter-container {
  padding: 10rpx 20rpx;
  background-color: #f5f5f5;
}
.clear-filter-btn {
  background-color: #fff;
  color: #008dda;
  border: 1px solid #008dda;
  border-radius: 30rpx;
  padding: 8rpx 20rpx;
  font-size: 26rpx;
}
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.filter-bar {
  background-color: white;
  padding: 15rpx 30rpx;
  display: flex;
  flex-wrap: wrap;
  border-bottom: 1rpx solid #eee;
}

.filter-item {
  width: 50%;
  padding: 10rpx 0;
  display: flex;
  align-items: center;
}

.filter-label {
  color: #666;
  font-size: 26rpx;
  width: 180rpx;
}

.filter-value {
  color: #333;
  font-size: 28rpx;
  font-weight: 500;
}

.sort-bar {
  display: flex;
  background-color: white;
  height: 88rpx;
  border-bottom: 1rpx solid #eee;
}

.sort-item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #666;
  font-size: 28rpx;
  position: relative;
}

.sort-item.active {
  color: #0084ff;
}

.sort-icon {
  width: 20rpx;
  height: 20rpx;
  margin-left: 10rpx;
}

.route-list {
  padding: 20rpx;
}

.route-card {
  background-color: white;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  display: flex;
  overflow: hidden;
}

.route-cover {
  width: 240rpx;
  height: 180rpx;
  border-radius: 12rpx 0 0 12rpx;
}

.route-info {
  flex: 1;
  padding: 15rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.route-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ship-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.route-days {
  font-size: 24rpx;
  color: #666;
  background-color: #f5f5f5;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.route-path {
  margin-top: 8rpx;
}

.path-text {
  font-size: 26rpx;
  color: #666;
}

.route-dates {
  margin-top: 4rpx;
}

.date-text {
  font-size: 24rpx;
  color: #999;
}

.route-price {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
}

.price-label {
  font-size: 24rpx;
  color: #999;
}

.price-value {
  font-size: 34rpx;
  font-weight: bold;
  color: #ff4500;
  margin-left: 10rpx;
}

.price-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 4rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-image {
  width: 240rpx;
  height: 240rpx;
  opacity: 0.6;
}

.empty-text {
  margin-top: 30rpx;
  font-size: 28rpx;
  color: #999;
}

.reset-btn {
  margin-top: 40rpx;
  background-color: #0084ff;
  color: white;
  font-size: 28rpx;
  padding: 15rpx 60rpx;
  border-radius: 50rpx;
}
.route-card {
  pointer-events: auto;
  cursor: pointer; 
}