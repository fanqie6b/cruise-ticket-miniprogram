.user-info {
  display: flex;
  align-items: center;
  padding: 30rpx 20rpx;
  background-color: #1296db;
  color: #fff;
  /* 增加底部阴影，提升层次感 */
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 3rpx solid white;
  /* 增加轻微阴影，突出头像 */
  box-shadow: 0 3rpx 8rpx rgba(0, 0, 0, 0.15);
}

.user-text {
  margin-left: 20rpx;
  flex: 1;
  /* 增加左对齐，提升视觉一致性 */
  text-align: left;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.user-level {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 未登录状态的登录按钮 */
.login-btn {
  margin-left: auto;
  background-color: #fff;
  color: #1296db;
  padding: 15rpx 30rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: bold;
  /* 增加按钮质感 */
  box-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.1);
}

/* 登录状态的退出按钮（居右、缩小） */
.logout-btn {
  margin-left: auto; /* 靠右对齐 */
  background-color: rgba(255, 255, 255, 0.2); /* 半透明白色背景 */
  color: #fff;
  padding: 8rpx 20rpx; /* 缩小尺寸 */
  border-radius: 20rpx; /* 圆角更精致 */
  font-size: 24rpx; /* 字体缩小 */
  font-weight: normal;
  /* 点击反馈 */
  transition: background-color 0.2s;
}

.logout-btn:active {
  background-color: rgba(255, 255, 255, 0.3);
}

.top-bar {
  background-color: #1296db;
  padding: 20rpx 10rpx 30rpx;
}

.top-btn-group {
  display: flex;
  justify-content: space-around;
}

.top-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
  width: 20%;
}

.top-btn .icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 10rpx;
}

.top-btn text {
  font-size: 24rpx;
}

.list-container {
  margin-top: 20rpx;
  background-color: #fff;
  /* 增加容器圆角和阴影 */
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  overflow: hidden; /* 配合圆角裁剪 */
}

.list-item {
  display: flex;
  align-items: center;
  padding: 25rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
  /* 点击反馈 */
  transition: background-color 0.2s;
}

.list-item:active {
  background-color: #f9f9f9;
}

.item-icon {
  width: 50rpx;
  height: 50rpx;
  margin-right: 20rpx;
}

.item-text {
  font-size: 30rpx;
  flex: 1;
}

.item-desc {
  font-size: 24rpx;
  color: #999;
  margin-right: 20rpx;
}

.arrow {
  width: 20rpx;
  height: 36rpx;
  opacity: 0.6; /* 箭头弱化，突出主要内容 */
}
/* 订单空状态样式 */
.empty-state {
  padding: 60rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

/* 订单按钮样式 */
.order-btn {
  margin-top: 15rpx;
  padding: 8rpx 20rpx;
  font-size: 26rpx;
}

/* 选中状态样式 */
.top-btn.active {
  color: #007aff;
}

/* 订单状态文本样式 */
.order-status {
  display: block;
  margin-top: 10rpx;
  color: #666;
  font-size: 26rpx;
}
/* pages/mine/mine.wxss */
/* 添加以下样式 */
.order-item {
  padding: 15px;
  border-bottom: 1px solid #eee;
}

.order-id, .order-route, .order-date, .order-price {
  display: block;
  margin-bottom: 8px;
}

.order-route {
  color: #333;
  font-weight: 500;
}

.order-price {
  color: #f60;
}

.order-btn {
  margin-top: 10px;
  background-color: #008dda;
  color: white;
  padding: 5px 15px;
  border-radius: 4px;
  font-size: 14px;
}
.order-tabs {
  display: flex;
  border-bottom: 1px solid #eee;
  margin-bottom: 15px;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 12px 0;
  font-size: 14px;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #008dda; 
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background-color: #008dda; 
}
.tab-item {
  cursor: pointer;
  transition: all 0.3s ease;
}

.tab-item:active {
  background-color: rgba(0, 141, 218, 0.1);
}

.tab-item.active::before {
  content: '▼';
  font-size: 16rpx;
  margin-right: 8rpx;
  opacity: 0.8;
}