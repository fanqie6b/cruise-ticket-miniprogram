<!--pages/insurance/insurance.wxml-->
<view class="insurance-container">
  <view class="page-header">
    <text class="title">保险</text>
    <text class="desc">为你的海上行程添一份保障</text>
  </view>

  <!-- 保险方案卡片 -->
  <view class="insurance-card">
    <view class="plan-info">
      <text class="plan-title">基础保障计划</text>
      <text class="plan-desc">覆盖行程取消、意外医疗、行李延误</text>
      <text class="price">¥{{basePrice}} 起</text>
    </view>
    <button class="buy-btn" bindtap="buyBasePlan">立即投保</button>
  </view>

  <!-- 升级方案（可选） -->
  <view class="insurance-card upgrade">
    <view class="plan-info">
      <text class="plan-title">豪华保障计划</text>
      <text class="plan-desc">含基础保障+航班延误、高保额意外</text>
      <text class="price">¥{{upgradePrice}} 起</text>
    </view>
    <button class="buy-btn" bindtap="buyUpgradePlan">升级投保</button>
  </view>

  <!-- 投保须知 -->
  <view class="notice-section">
    <text class="notice-title">投保须知</text>
    <text class="notice-item">1. 投保后不可单独取消，随船票订单同步退改</text>
    <text class="notice-item">2. 理赔需在行程结束后 7 个工作日内提交材料</text>
    <text class="notice-item">3. 详细条款以保险公司最终合同为准</text>
  </view>
</view>