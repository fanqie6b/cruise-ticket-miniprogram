<view class="activity-container">
  <!-- 子标签栏 -->
  <view class="sub-tab" wx:if="{{currentTab === 'activity'}}">
    <!-- 歌舞演绎子标签项，点击切换子标签，当前子标签为"sing"时添加active类 -->
    <view 
      class="sub-tab-item {{currentSubTab === 'sing' ? 'active' : ''}}" 
      bindtap="switchSubTab" 
      data-subtab="sing"
    >
      歌舞演绎
    </view>
    <!-- 亲子童趣子标签项，点击切换子标签，当前子标签为"parent"时添加active类 -->
    <view 
      class="sub-tab-item {{currentSubTab === 'parent' ? 'active' : ''}}" 
      bindtap="switchSubTab" 
      data-subtab="parent"
    >
      亲子童趣
    </view>
    <!-- 休闲娱乐子标签项，点击切换子标签，当前子标签为"leisure"时添加active类 -->
    <view 
      class="sub-tab-item {{currentSubTab === 'leisure' ? 'active' : ''}}" 
      bindtap="switchSubTab" 
      data-subtab="leisure"
    >
      休闲娱乐
    </view>
  </view>

  <!-- 内容区域，仅在当前主标签为"activity"时显示 -->
  <view class="content" wx:if="{{currentTab === 'activity'}}">
    <!-- 循环渲染活动列表，使用id作为唯一标识 -->
    <block wx:for="{{activityList}}" wx:key="id">
      <!-- 活动卡片容器 -->
      <view class="activity-card">
        <!-- 活动图片 -->
        <image class="activity-img" src="{{item.image}}"></image>
        <!-- 活动标题 -->
        <view class="activity-title">{{item.title}}</view>
        <!-- 活动描述 -->
        <view class="activity-desc">{{item.desc}}</view>
        <!-- 活动详情 -->
        <view class="activity-detail">{{item.detail}}</view>
      </view>
    </block>
  </view>
</view>